# Copy to your host's environment settings (not committed).
PORT=3000
# Password for the salon dashboard at /admin — pick something long.
ADMIN_PASSWORD=change-me-to-something-long
# Optional: where bookings are stored (use a persistent disk on your host).
DATA_DIR=./data
# Optional: get a ping for every new booking (Discord/Slack webhook, ntfy.sh, Zapier, Make…).
NOTIFY_WEBHOOK_URL=
